# RepoTrackr AI — frontend environment (Vite)
# Copy to .env and edit. Only VITE_* vars are exposed to the browser.

# Base URL of the FastAPI backend.
VITE_API_URL=http://localhost:8000

# Opt-in demo mode. When true, the graph uses local mock data; the Part 3/4
# query endpoints always fall back to local mock data because they are stubs.
# Leave false to use the real deterministic graph endpoint.
VITE_USE_MOCKS=false
